# Copy this file to .env and fill in real values before running.
# On Render, add these as Environment Variables in the dashboard instead.

# SQLite is the default — no separate database service needed.
# If you outgrow it later, swap this for a Postgres URL and add asyncpg back
# to requirements.txt; nothing else in the code needs to change.
DATABASE_URL=sqlite+aiosqlite:///./voting.db

JWT_SECRET_KEY=replace-this-with-a-long-random-string

# SMTP for sending OTP verification emails.
# If using Gmail: enable 2FA on the account, then generate an "App Password" —
# do NOT use your normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# First admin account, created automatically on first startup
FIRST_ADMIN_INDEX=ADMIN001
FIRST_ADMIN_PASSWORD=choose-a-strong-password
FIRST_ADMIN_EMAIL=admin@yourschool.edu
